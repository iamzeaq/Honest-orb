 "note": "Honest Orb conversation evals. Core scripts run live against converse(). Domain probes carry explicit expects calibrated to the data actually loaded (Constitution 1999 + Police Act 2020 only; the ten new-law PDFs are absent from data/raw/). Unloaded-domain probes honestly expect not_covered + Legal Aid pointer + EMPTY citations. When a domain's PDF lands and sections.json is rebuilt, flip that probe to expect legal + cites.",
 "sessions": [
  {
   "id": "A-memory-tenancy-police",
   "turns": [
    {
     "expect": {
      "citations_empty": true,
      "mode": [
       "chat"
      ]
     },
     "id": "A1",
     "text": "Hello"
    },
    {
     "expect": {
      "citations_empty": true,
      "mode": [
       "redirect"
      ]
     },
     "id": "A2",
     "text": "Who won the match yesterday?"
    },
    {
     "expect": {
      "citations_empty": true,
      "facts": {
       "topic": "tenancy"
      },
      "mode": [
       "clarify"
      ]
     },
     "id": "A3",
     "text": "My landlord says I must leave next week"
    },
    {
     "expect": {
      "citations_empty": true,
      "facts": {
       "state": "lagos",
       "topic": "tenancy"
      },
      "mode": [
       "not_covered"
      ],
      "spoken_contains": [
       "Legal Aid"
      ]
     },
     "id": "A4",
     "text": "Lagos"
    },
    {
     "expect": {
      "cite_any": [
       "CFRN-s37",
       "NPA2020-s49",
       "NPA2020-s51"
      ],
      "facts": {
       "state": "lagos"
      },
      "mode": [
       "legal"
      ]
     },
     "id": "A5",
     "text": "Also, police took my phone yesterday"
    },
    {
     "expect": {
      "mode": [
       "emergency"
      ],
      "spoken_contains": [
       "112"
      ]
     },
     "id": "A6",
     "text": "Police beat me in the cell to make me confess"
    }
   ]
  },
